# Frontend settings for the React app (client/).

# The backend is the separate next-level-backend project (https://github.com/Mamadaliyevamubina/next-level-backend),
# on this computer in ~/Desktop/next-level-backend. Start it with "npm run dev" there; it listens on http://localhost:4000.

# Development: the Vite dev server forwards /api to this address. Change it only if the backend uses another port.
API_PROXY_TARGET=http://localhost:4000

# Production / another computer: the full address of the backend, e.g. https://api.example.org
# Leave empty to use the dev proxy above. When set, add this site's address to CORS_ORIGINS in the backend's .env.
VITE_API_URL=
